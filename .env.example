# ==============================================================================
# Environment Configuration for Hermes Agent on Hetzner VPS
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# Host user and group ID (run `id -u` and `id -g` on your VPS, usually 1000)
HERMES_UID=1000
HERMES_GID=1000

# Docker image version
HERMES_IMAGE_TAG=latest

# API Server Settings (OpenAI-compatible endpoint on port 8642)
# Set a strong random key: openssl rand -hex 24
API_SERVER_KEY=change_me_to_a_secure_token_or_secret_key
API_SERVER_HOST=0.0.0.0

# LLM Providers (Configure at least one, or use Nous Portal during `hermes setup`)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Messaging Gateways (fill if using these integrations)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Reverse Proxy / Domain Configuration (Required if using Caddy for HTTPS)
HERMES_DOMAIN=hermes.yourdomain.com
CADDY_LETSENCRYPT_EMAIL=admin@yourdomain.com

# Basic Auth for Dashboard when exposed via Caddy (generate hash with: caddy hash-password)
# Leave blank if accessing dashboard purely via SSH tunnel (recommended)
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_HASH=
