# Telegram Bot Configuration
# 1. Message @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Message @userinfobot on Telegram to get your numeric ID
TELEGRAM_ALLOWED_USERS=your_numeric_user_id_here

# LLM Provider Key (provide at least one)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Host user/group IDs (usually 1000)
HERMES_UID=1000
HERMES_GID=1000
